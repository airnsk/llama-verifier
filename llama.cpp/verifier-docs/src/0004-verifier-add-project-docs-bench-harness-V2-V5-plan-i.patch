+ //   {"prefix_tokens":[...], "chains":[{"tokens":[...]}], "mode":"greedy", "temperature":0}
+-//   -> {"chain_id","accepted","bonus_token","tokens_out","verify_ms", ...}
++//   -> {"chain_id","accepted","bonus_token","tokens_out","prefill_ms","verify_ms","round_ms"}
